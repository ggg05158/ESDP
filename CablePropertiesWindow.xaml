<Window x:Class="ESDP.CablePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="케이블 정보" Height="540" Width="1250"
        MinHeight="440" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="케이블 이름" VerticalAlignment="Center"/>
            <TextBox x:Name="CableNameBox" Grid.Column="1" Margin="0,0,18,0"/>
            <TextBlock Grid.Column="2" Text="케이블 종류" VerticalAlignment="Center"/>
            <ComboBox x:Name="CategoryCombo" Grid.Column="3"
                      SelectionChanged="CategoryCombo_SelectionChanged"/>
            <Button x:Name="CableColorButton" Grid.Column="4" Content="선 색…"
                    Margin="8,0,0,0" Click="CableColorButton_Click"/>
            <Border Grid.Column="5" Width="42" Height="22" Margin="8,0,0,0"
                    BorderBrush="{DynamicResource AppStrongBorderBrush}" BorderThickness="1">
                <Rectangle x:Name="CableColorSwatch"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
        <CheckBox x:Name="ShowCableNameCheck" VerticalAlignment="Center"
                  Content="캔버스에 케이블명 표시"
                  IsChecked="True"/>
            <TextBlock Text="이름 글자 크기" Margin="24,0,8,0" VerticalAlignment="Center"/>
            <TextBox x:Name="CableNameFontSizeBox" Width="64" VerticalContentAlignment="Center"
                     ToolTip="6~200px, 같은 케이블의 이름에 적용"/>
            <TextBlock Text="px" Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,4,0,5">
            <Button Content="케이블 세부 신호 설정…"
                    DockPanel.Dock="Right" Width="174" Height="30"
                    Click="CableSignalsButton_Click"/>
            <TextBlock Text="포트 정보" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Content="＋ 포트 추가" Width="100" Height="30" Margin="12,0,0,0"
                    Click="AddPortButton_Click"/>
        </DockPanel>
        <TextBlock Grid.Row="3"
                   Text="포트 이름은 이 케이블에만 적용됩니다. 연결 상태는 현재 캔버스 기준입니다."
                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,0,0,8"/>

        <DataGrid x:Name="PortsGrid" Grid.Row="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="{DynamicResource AppAlternateRowBrush}"
                  RowHeaderWidth="0">
            <DataGrid.Resources>
                <Style x:Key="CenteredPortHeaderStyle" TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
                <Style x:Key="CenteredPortTextStyle" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                </Style>
                <Style x:Key="CenteredPortEditorStyle" TargetType="TextBox">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                </Style>
                <Style x:Key="CenteredPortCheckStyle" TargetType="CheckBox">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="포트 이름" Width="115"
                                    HeaderStyle="{StaticResource CenteredPortHeaderStyle}"
                                    ElementStyle="{StaticResource CenteredPortTextStyle}"
                                    EditingElementStyle="{StaticResource CenteredPortEditorStyle}"
                                    Binding="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridCheckBoxColumn Header="이름 표시" Width="75"
                                        HeaderStyle="{StaticResource CenteredPortHeaderStyle}"
                                        ElementStyle="{StaticResource CenteredPortCheckStyle}"
                                        EditingElementStyle="{StaticResource CenteredPortCheckStyle}"
                                        Binding="{Binding ShowLabel, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn Header="커넥터 타입" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ConnType, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         TextChanged="ConnectorTypeTextBox_TextChanged"/>
                                <Button Grid.Column="1" Content="🔍" Style="{StaticResource CompactIconButtonStyle}" Margin="3,0,0,0" Padding="0"
                                        ToolTip="커넥터 검색"
                                        Click="D38999SearchButton_Click"/>
                                <Button Grid.Column="2" Content="◉" Style="{StaticResource CompactIconButtonStyle}" Margin="3,0,0,0" Padding="0"
                                        ToolTip="핀 배열 보기"
                                        Click="PinLayoutButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="타입 표시" Width="75"
                                        HeaderStyle="{StaticResource CenteredPortHeaderStyle}"
                                        ElementStyle="{StaticResource CenteredPortCheckStyle}"
                                        EditingElementStyle="{StaticResource CenteredPortCheckStyle}"
                                        Binding="{Binding ShowConnType, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="글자 크기" Width="70"
                                    HeaderStyle="{StaticResource CenteredPortHeaderStyle}"
                                    ElementStyle="{StaticResource CenteredPortTextStyle}"
                                    EditingElementStyle="{StaticResource CenteredPortEditorStyle}"
                                    Binding="{Binding LabelFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn Header="글자색" Width="78">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="색 선택…" Margin="3,1"
                                    Click="PortLabelColorButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="현재 연결 상태" Width="115"
                                        IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="6,3"
                                       ToolTip="{Binding ConnectionStatus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="비고 / 설명" Width="*"
                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Width="86" Height="30" Margin="0,0,8,0"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button Content="취소" Width="86" Height="30"
                    IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
