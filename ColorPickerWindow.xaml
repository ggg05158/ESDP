<Window x:Class="ESDP.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="색 선택" Width="500" Height="620"
        MinWidth="480" MinHeight="590"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="테마 색" FontWeight="SemiBold"
                   FontSize="14" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1">
            <!-- Office 팔레트처럼 기본색 10개를 먼저 한 줄로 표시 -->
            <ItemsControl x:Name="BaseThemeColors">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                                <Button Width="38" Height="32" Margin="2" Padding="2" Style="{StaticResource TileButtonStyle}"
                                Tag="{Binding Hex}" Click="ColorSwatch_Click"
                                ToolTip="{Binding Name}">
                            <Rectangle Width="30" Height="22"
                                       Fill="{Binding Brush}" Stroke="{DynamicResource AppPanelHeaderBorderBrush}"
                                       StrokeThickness="1"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 각 기본색 아래에 밝음→어두움 5단계를 세로 열로 배치 -->
            <ItemsControl x:Name="ThemeShadeColumns" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Shades}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                <Button Width="42" Height="30" Padding="0" Style="{StaticResource TileButtonStyle}"
                                            Margin="0" BorderThickness="0"
                                            Tag="{Binding Hex}"
                                            Click="ColorSwatch_Click"
                                            ToolTip="{Binding Name}">
                                        <Rectangle Width="38" Height="30"
                                                   Fill="{Binding Brush}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="최근 색" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ItemsControl x:Name="RecentColors">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                                <Button Width="32" Height="28" Margin="2" Padding="2" Style="{StaticResource TileButtonStyle}"
                                Tag="{Binding Hex}" Click="ColorSwatch_Click">
                            <Rectangle Width="24" Height="20"
                                       Fill="{Binding Brush}" Stroke="{DynamicResource AppStrongBorderBrush}"
                                       StrokeThickness="1"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="10"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                Background="{DynamicResource AppAlternateRowBrush}" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="HEX" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBox Grid.Column="1" x:Name="HexBox" TextChanged="HexBox_TextChanged"
                         VerticalContentAlignment="Center"/>
                <Rectangle Grid.Column="2" x:Name="SelectedPreview"
                           Width="34" Height="28" Margin="10,0"
                           Stroke="{DynamicResource AppStrongBorderBrush}" StrokeThickness="1"/>
                <TextBlock Grid.Column="3" Text="현재 선택 색"
                           VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}"/>
                <Button Grid.Column="4" Content="⌾ 스포이트" Style="{StaticResource SubtleButtonStyle}" Padding="10,5"
                        Click="EyedropperButton_Click"
                        ToolTip="화면에서 원하는 색을 클릭하여 가져옵니다"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,12,0,0" Foreground="{DynamicResource AppMutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="테마 색을 선택하거나 HEX 값을 입력하세요. 스포이트를 누르면 화면의 다른 프로그램 색도 가져올 수 있습니다."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Width="80" Margin="0,0,8,0"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button Content="취소" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
