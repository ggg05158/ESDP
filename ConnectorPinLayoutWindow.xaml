<Window x:Class="ESDP.ConnectorPinLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="핀 배열 보기" Width="1050" Height="780" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="GuideText" Margin="0,4,0,0" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="{DynamicResource AppSubtlePanelBrush}" Padding="8">
            <Grid>
                <Viewbox x:Name="LayoutViewbox" Stretch="Uniform">
                    <Grid x:Name="CoordinateHost">
                        <Image x:Name="LayoutImage" Stretch="Fill"/>
                        <Canvas x:Name="MarksCanvas" Background="Transparent"
                                ToolTipService.InitialShowDelay="250"
                                ToolTipService.ShowDuration="12000"/>
                    </Grid>
                </Viewbox>
                <TextBlock x:Name="NoImageText" Text="핀 배열 이미지가 등록되지 않았습니다."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedTextBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="EditPositionsButton" Content="핀 위치 설정…" Width="112" Height="31" Margin="0,0,8,0" Click="EditPositionsButton_Click"/>
            <Button Content="닫기" Width="86" Height="31" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
