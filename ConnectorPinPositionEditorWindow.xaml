<Window x:Class="ESDP.ConnectorPinPositionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="핀 위치 설정" Width="1120" Height="820"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="핀 번호를 입력한 다음 이미지에서 해당 핀의 중심을 클릭하세요. 이 좌표는 같은 커넥터에서 재사용됩니다."
                       Margin="0,4,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <CheckBox x:Name="SnapToPinCheck" Content="핀 원 중심에 자석 맞춤" IsChecked="True"
                          VerticalAlignment="Center" ToolTip="클릭 지점 가까이에 핀 원이 인식되면 중심으로 자동 보정합니다."/>
                <TextBlock Text="표시 지름(pt)" Margin="18,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="MarkerSizeBox" Width="48" Height="25" VerticalContentAlignment="Center"
                         TextChanged="MarkerSizeBox_TextChanged" ToolTip="핀 위치 표시 원의 지름을 포인트 단위로 조절합니다."/>
                <TextBlock x:Name="DetectedSizeText" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="{DynamicResource AppSubtlePanelBrush}" Padding="8">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="CoordinateHost">
                    <Image x:Name="LayoutImage" Stretch="Fill"/>
                    <Canvas x:Name="PinsCanvas" Background="Transparent"
                            MouseLeftButtonDown="PinsCanvas_MouseLeftButtonDown"
                            MouseMove="PinsCanvas_MouseMove" MouseLeave="PinsCanvas_MouseLeave"/>
                </Grid>
            </Viewbox>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="{DynamicResource AppPanelBrush}" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="지정할 핀 번호" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,6,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="◀" Style="{StaticResource CompactIconButtonStyle}" Height="32" Padding="0" Margin="0,0,4,0"
                            ToolTip="이전 핀 번호" Click="PreviousPinButton_Click"/>
                    <TextBox x:Name="PinNumberBox" Grid.Column="1" Height="32"
                             VerticalContentAlignment="Center" TextAlignment="Center"/>
                    <Button Grid.Column="2" Content="▶" Style="{StaticResource CompactIconButtonStyle}" Height="32" Padding="0" Margin="4,0,0,0"
                            ToolTip="다음 핀 번호" Click="NextPinButton_Click"/>
                    <Button Grid.Column="3" Content="EX" Height="32" Padding="0" Margin="4,0,0,0"
                            ToolTip="예비핀으로 지정" Click="SparePinButton_Click"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="설정된 핀 위치" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ListBox x:Name="PositionsList" Grid.Row="3" DisplayMemberPath="DisplayText" SelectionChanged="PositionsList_SelectionChanged"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                <Button Content="선택 위치 삭제" Style="{StaticResource DangerButtonStyle}" Width="104" Height="30" Click="DeletePositionButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="저장" Style="{StaticResource PrimaryButtonStyle}" Width="90" Height="32" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="취소" Width="90" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
