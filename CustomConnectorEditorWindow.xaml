<Window x:Class="ESDP.CustomConnectorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="커넥터 추가" Width="620" Height="390"
        MinWidth="560" MinHeight="350"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="커넥터 시리즈" FontWeight="SemiBold"/>
            <TextBox x:Name="SeriesNameBox" Grid.Row="1" Height="30" Margin="0,5,0,12"
                     IsReadOnly="True" Background="{DynamicResource AppSubtlePanelBrush}" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="커넥터 이름" FontWeight="SemiBold"/>
            <TextBox x:Name="ConnectorNameBox" Grid.Row="3" Height="30" Margin="0,5,0,12"
                     VerticalContentAlignment="Center"/>
            <TextBlock Grid.Row="4" Text="핀 수" FontWeight="SemiBold"/>
            <TextBox x:Name="PinCountBox" Grid.Row="5" Height="30" Margin="0,5,0,0"
                     VerticalAlignment="Top" VerticalContentAlignment="Center"/>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="핀 배치 사진 (선택)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" Background="{DynamicResource AppSubtlePanelBrush}" Padding="6">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    <TextBlock x:Name="NoImageText" Text="선택한 이미지가 없습니다."
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="사진 선택..." Width="100" Height="29" Click="ChooseImageButton_Click"/>
                <TextBlock x:Name="ImageNameText" Margin="9,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="추가" Style="{StaticResource PrimaryButtonStyle}" Width="84" Height="30" IsDefault="True"
                    Margin="0,0,8,0" Click="AddButton_Click"/>
            <Button Content="취소" Width="84" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
