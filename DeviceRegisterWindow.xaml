<Window x:Class="ESDP.DeviceRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="장치 등록" Height="560" Width="1160"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="180"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 입력 폼 (요소들이 창 너비에 맞춰 늘어남) -->
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="장치 이름:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="NameBox" Width="260" HorizontalAlignment="Left"
                         TextChanged="AnyField_Changed"/>
                <TextBlock x:Name="PurposeLabel" Text="용도:" Margin="14,0,6,0"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBox x:Name="PurposeBox" Width="180" HorizontalAlignment="Left"
                         ToolTip="입력하면 캔버스에서 장치 이름 다음 줄에 괄호로 표시됩니다"
                         TextChanged="AnyField_Changed" Visibility="Collapsed"/>
                <TextBlock x:Name="ZoneLabel" Text="현재 구역:" Margin="14,0,6,0"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <ComboBox x:Name="ZoneCombo" Width="150" HorizontalAlignment="Left"
                          VerticalContentAlignment="Center" Visibility="Collapsed"
                          ToolTip="이 배치 개체가 속한 구역"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="장치 종류:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="KindCombo" HorizontalAlignment="Left" Width="150"
                          SelectionChanged="KindCombo_SelectionChanged"/>
            <Button Content="＋" Style="{StaticResource CompactIconButtonStyle}" Width="28" Height="25" Margin="5,0,0,0"
                        ToolTip="새 장치 범주 추가" Click="AddCustomKindButton_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="장치 배경색:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                <StackPanel x:Name="BackgroundColorPanel" Orientation="Horizontal">
                    <Button x:Name="BackgroundColorPickerButton" Content="색 선택…" Padding="8,2"
                            Click="BackgroundColorPickerButton_Click"/>
                    <Border Width="30" Height="20" Margin="8,0,0,0" BorderBrush="#7F7F7F" BorderThickness="1">
                        <Rectangle x:Name="BackgroundColorSwatch" Fill="White"/>
                    </Border>
                    <TextBlock x:Name="BackgroundColorHexText" Margin="7,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}"/>
                </StackPanel>
                <WrapPanel Margin="0,7,0,0">
                    <Button Content="배경 이미지…" Padding="8,2"
                            Click="BackgroundImageButton_Click"/>
                    <Button x:Name="RemoveBackgroundImageButton" Content="이미지 제거"
                            Margin="6,0,0,0" Padding="8,2"
                            Click="RemoveBackgroundImageButton_Click"/>
                    <Button x:Name="ResetNamePositionButton" Content="이름 중앙 배치"
                            Margin="6,0,0,0" Padding="8,2"
                            ToolTip="배경 이미지 위의 장치 이름을 중앙으로 되돌립니다"
                            Click="ResetNamePositionButton_Click"/>
                    <ComboBox x:Name="BackgroundImageStretchCombo" Width="112"
                              Margin="8,0,0,0" SelectionChanged="BackgroundImageOption_Changed">
                        <ComboBoxItem Content="전체 보기 (기본)" Tag="Uniform"/>
                        <ComboBoxItem Content="꽉 채우기" Tag="UniformToFill"/>
                        <ComboBoxItem Content="늘여서 채우기" Tag="Fill"/>
                    </ComboBox>
                    <TextBlock Text="투명도" Margin="8,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="BackgroundImageOpacityBox" Width="40" Text="100"
                             VerticalContentAlignment="Center" TextChanged="BackgroundImageOpacity_Changed"/>
                    <TextBlock Text="%" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock x:Name="BackgroundImageNameText" Margin="0,5,0,0"
                           Text="이미지 없음" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppMutedTextBrush}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="글자 효과:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="글자 크기/색:" VerticalAlignment="Center" Margin="0,0,8,8"/>

            <!-- 이름 위치 선택은 글자 효과/크기 두 행에 공통으로 적용되므로
                 오른쪽에서 두 행을 함께 사용해 하나의 설정 묶음으로 보이게 한다. -->
            <Grid Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="BoldCheck" Content="굵게" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ItalicCheck" Content="기울임" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="UnderlineCheck" Content="밑줄" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBox x:Name="FontSizeBox" Width="45" Text="10"/>
                    <ComboBox x:Name="TextColorCombo" Width="110" Margin="10,0,0,0"/>
                    <Button Content="색 선택…" Margin="6,0,0,0" Padding="8,2"
                            Click="TextColorPickerButton_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                           Text="이름 위치" Margin="14,0,6,0"
                           VerticalAlignment="Center"/>
                <UniformGrid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                             Rows="3" Columns="3" Width="72" Height="66"
                             VerticalAlignment="Center"
                             ToolTip="장치 이름을 선택한 위치에 맞춥니다. 미리보기에서 직접 끌어 옮길 수도 있습니다.">
                    <Button Content="↖" Tag="0,0" Padding="0" Margin="1"
                            ToolTip="왼쪽 위" Click="NamePositionButton_Click"/>
                    <Button Content="↑" Tag="0.5,0" Padding="0" Margin="1"
                            ToolTip="위쪽 가운데" Click="NamePositionButton_Click"/>
                    <Button Content="↗" Tag="1,0" Padding="0" Margin="1"
                            ToolTip="오른쪽 위" Click="NamePositionButton_Click"/>
                    <Button Content="←" Tag="0,0.5" Padding="0" Margin="1"
                            ToolTip="왼쪽 가운데" Click="NamePositionButton_Click"/>
                    <Button Content="●" Tag="0.5,0.5" Padding="0" Margin="1"
                            ToolTip="정가운데" Click="NamePositionButton_Click"/>
                    <Button Content="→" Tag="1,0.5" Padding="0" Margin="1"
                            ToolTip="오른쪽 가운데" Click="NamePositionButton_Click"/>
                    <Button Content="↙" Tag="0,1" Padding="0" Margin="1"
                            ToolTip="왼쪽 아래" Click="NamePositionButton_Click"/>
                    <Button Content="↓" Tag="0.5,1" Padding="0" Margin="1"
                            ToolTip="아래쪽 가운데" Click="NamePositionButton_Click"/>
                    <Button Content="↘" Tag="1,1" Padding="0" Margin="1"
                            ToolTip="오른쪽 아래" Click="NamePositionButton_Click"/>
                </UniformGrid>
            </Grid>

            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                <TextBlock Text="포트 목록" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="AddPortButton" Content="＋ 포트 추가" Margin="12,0,0,0"
                        Padding="8,2" Click="AddPortButton_Click"/>
                <TextBlock Text="(이름만 등록 — 위치는 캔버스에 놓은 뒤 마우스로 조절)"
                           Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppPanelHeaderBrush}" BorderBrush="{DynamicResource AppPanelHeaderBorderBrush}"
                            BorderThickness="0,0,0,1" Padding="4,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="포트 이름" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="이름 표시" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="커넥터 타입" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="타입 표시" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="글자 크기" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="글자 색" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="비고 / 설명" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PortItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                     <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                     </Grid.ColumnDefinitions>
                                     <TextBox Grid.Column="0" Text="{Binding Designator, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="포트 이름" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowLabel}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              ToolTip="도면에 포트 이름 표시"/>
                                    <Grid Grid.Column="2" Margin="5,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ConnType, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="커넥터 타입 (conn_type)"/>
                            <Button Grid.Column="1" Content="🔍" Style="{StaticResource CompactIconButtonStyle}" Margin="3,0,0,0"
                                                Padding="0" ToolTip="D38999 커넥터 검색"
                                                Click="D38999SearchButton_Click"/>
                                    </Grid>
                                    <CheckBox Grid.Column="3" IsChecked="{Binding ShowConnType}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              ToolTip="도면에 커넥터 타입 표시"/>
                                    <TextBox Grid.Column="4" Margin="5,0,0,0"
                                             Text="{Binding LabelFontSize, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="포트 이름 글자 크기"/>
                                    <Button Grid.Column="5" Content="글자색…" Margin="5,0,0,0"
                                            Click="PortLabelColorButton_Click"
                                            ToolTip="이 포트 이름의 글자색"/>
                                    <TextBox Grid.Column="6" Margin="5,0,0,0"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="포트 비고 또는 설명"/>
                            <Button Grid.Column="7" Content="×" Style="{StaticResource DangerIconButtonStyle}" Width="30" Height="25"
                                            Margin="6,0,0,0" FontSize="16" Padding="0"
                                            ToolTip="이 포트 삭제" Click="RemovePortButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="등록" Style="{StaticResource PrimaryButtonStyle}" Width="80" Margin="0,0,8,0" Click="OkButton_Click"/>
                <Button Content="취소" Width="80" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 오른쪽: 실시간 미리보기. Viewbox 로 감싸서 창 크기에 맞춰 같이 늘어남 -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource AppStrongBorderBrush}" BorderThickness="1" Margin="10,0,0,0" Background="{DynamicResource AppSubtlePanelBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,4">
                    <TextBlock Text="미리보기" FontWeight="Bold"/>
                    <TextBlock x:Name="NameDragHintText"
                               Text="장치 이름을 드래그해 자유롭게 옮기거나, 왼쪽의 3×3 위치 버튼으로 정렬할 수 있습니다."
                               Margin="0,3,0,0" FontSize="10"
                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Margin="10">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <Canvas x:Name="PreviewCanvas"
                                MouseMove="PreviewCanvas_MouseMove"
                                MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp"/>
                    </Viewbox>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
