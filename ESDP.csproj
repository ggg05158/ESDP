<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\Branding\ESDP.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ESDP.BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Templates\cable_list_template.xlsx"
                      LogicalName="ESDP.Resources.CableListTemplate.xlsx" />
    <EmbeddedResource Include="Resources\Templates\subsystem_list_template.xlsx"
                      LogicalName="ESDP.Resources.DeviceListTemplate.xlsx" />
    <EmbeddedResource Include="Resources\ExcelHtmlImporter\index.html"
                      LogicalName="ESDP.Resources.ExcelHtmlImporter.index.html" />
    <EmbeddedResource Include="Resources\ExcelHtmlImporter\app.js"
                      LogicalName="ESDP.Resources.ExcelHtmlImporter.app.js" />
    <EmbeddedResource Include="Resources\ExcelHtmlImporter\jszip.min.js"
                      LogicalName="ESDP.Resources.ExcelHtmlImporter.jszip.min.js" />
    <EmbeddedResource Include="Resources\ExcelHtmlImporter\JSZip-LICENSE.markdown"
                      LogicalName="ESDP.Resources.ExcelHtmlImporter.JSZip-LICENSE.markdown" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\D38999_connector_data\D38999_Insert_Images\images\*.png" />
    <Resource Include="Resources\Branding\ESDP_loading.png" />
    <Resource Include="Resources\Branding\ESDP.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Regression harness is built independently, not compiled into the application. -->
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>
</Project>
