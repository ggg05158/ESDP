<Window x:Class="ESDP.RenamePortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="포트 이름 변경" Height="220" Width="460"
        MinHeight="210" MinWidth="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="포트 이름:" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" x:Name="NameBox" VerticalAlignment="Top"
                 KeyDown="NameBox_KeyDown"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Width="70" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="취소" Width="70" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
