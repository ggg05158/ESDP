<Window x:Class="ESDP.ShapePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="도형 세부 설정" Width="860" Height="680" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="모양 · 크기 · 텍스트 · 서식" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <TabControl x:Name="OptionsTabs" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="미리보기" FontWeight="SemiBold" Margin="0,8,0,8"/>
                <Border Background="White" BorderBrush="{DynamicResource AppStrongBorderBrush}"
                        BorderThickness="1" Padding="14" Height="270">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="PreviewCanvas" Width="240" Height="180" ClipToBounds="False"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="노란 핸들: 모양 조절&#x0a;흰 핸들: 크기 조절&#x0a;회전 핸들: 회전 (Shift: 15°)"
                           TextWrapping="Wrap" MaxWidth="240" HorizontalAlignment="Left"
                           Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,12,0,0"/>
                <TextBlock Text="점 편집과 그룹 기능은 캔버스에서 도형 편집 메뉴를 사용하세요."
                           TextWrapping="Wrap" MaxWidth="240" HorizontalAlignment="Left"
                           Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="취소" Width="90" Height="34" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="적용" Width="90" Height="34" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OkButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
