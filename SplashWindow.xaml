<Window x:Class="ESDP.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESDP"
        Width="1080" Height="607"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True"
        Background="#240800"
        Icon="/Resources/Branding/ESDP.ico">
    <Window.Resources>
        <Storyboard x:Key="LoadingRotation">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.85"
                             RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Image Source="/Resources/Branding/ESDP_loading.png"
               Stretch="UniformToFill" SnapsToDevicePixels="True"/>

        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,38,30" Padding="13,8,16,8"
                Background="#730F0300" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Grid Width="24" Height="24" Margin="0,0,10,0"
                      VerticalAlignment="Center">
                    <Ellipse Width="20" Height="20"
                             Stroke="#55FFFFFF" StrokeThickness="2.3"/>
                    <Path Data="M 12,2 A 10,10 0 0 1 22,12"
                          Stroke="White" StrokeThickness="2.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"
                                             CenterX="12" CenterY="12"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock Text="Loading..." Foreground="White"
                           FontFamily="Segoe UI" FontSize="17"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource LoadingRotation}"/>
        </EventTrigger>
    </Window.Triggers>
</Window>
