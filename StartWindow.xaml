<Window x:Class="ESDP.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESDP" Height="460" Width="900"
        MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Background="{DynamicResource AppSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="24" Padding="18"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="최근 프로젝트" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="최근에 열거나 저장한 프로젝트"
                           Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,4,0,12"/>

                <Grid Grid.Row="2">
                    <TextBlock x:Name="NoRecentProjectsText"
                               Text="아직 최근 프로젝트가 없습니다."
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecentProjectsList"
                                      HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding FullPath}"
                                        Click="RecentProjectButton_Click"
                                        ToolTip="{Binding FullPath}"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Padding="8,7"
                                        Margin="0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Folder}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="270">
            <TextBlock Text="ESDP" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Electronic Systems Design Program"
                       FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,34"/>

            <Button x:Name="NewProjectButton" Content="＋  새 프로젝트" Style="{StaticResource PrimaryButtonStyle}" Height="42" Margin="0,0,0,10"
                    Click="NewProjectButton_Click"/>
            <Button x:Name="OpenProjectButton" Content="프로젝트 불러오기..." Height="42"
                    Click="OpenProjectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
